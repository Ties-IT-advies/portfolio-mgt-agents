#!/usr/bin/env bash
# Pre-push hook: scans added lines and filenames for org-sensitive terms.
# If no denylist exists, prints a warning and allows the push.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
SCAN="$REPO_ROOT/skill/idea-gate/scripts/scan_org_terms.py"
ZERO="0000000000000000000000000000000000000000"
EMPTY_TREE="4b825dc642cb6eb9a060e54bf8d69288fbee4904"

while IFS=' ' read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue  # branch deletion, nothing to scan

    if [ "$remote_sha" = "$ZERO" ]; then
        range="${EMPTY_TREE}..${local_sha}"
    else
        range="${remote_sha}..${local_sha}"
    fi

    python "$SCAN" --push "$range" || exit 1
done
